# DistrictLens environment template
# Copy to .env.local or the environment format used by your chosen framework.

# Public data APIs
FEC_API_KEY=
CONGRESS_API_KEY=
GEOCODIO_API_KEY=
GEOCODIO_DEFAULT_FIELDS=cd120
GEOCODIO_BASE_URL=https://api.geocod.io/v1.12

# Optional source-discovery provider
PERPLEXITY_API_KEY=
SEARCH_PROVIDER=perplexity
PERPLEXITY_SEARCH_MODEL=sonar
PERPLEXITY_LOCAL_RACE_DISCOVERY_ENABLED=false
PERPLEXITY_OFFICIAL_DOMAIN_ONLY=true
PERPLEXITY_RECENCY_FILTER=month

# Storage and retrieval
MONGODB_URI=
MONGODB_DB=districtlens
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# LLM / agent provider
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# App
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Optional Clerk authentication
# Keep core civic reads public. Use Clerk for saved user features and admin-protected workflows.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/
CLERK_AFTER_SIGN_UP_URL=/
CLERK_AUTH_ENABLED=false
CLERK_REQUIRE_AUTH_FOR_PUBLIC_READS=false
ADMIN_AUTH_MODE=clerk_or_secret
ADMIN_API_SECRET=


# State and local election data providers
# Current race source priority: ballotready_civicengine, ballotpedia, official_seed, democracy_works_calendar, google_civic_fallback
STATE_LOCAL_ELECTION_PROVIDER=ballotready_civicengine
BALLOTREADY_API_KEY=
BALLOTREADY_BASE_URL=
CIVICENGINE_API_KEY=
CIVICENGINE_BASE_URL=https://api.civicengine.com
BALLOTPEDIA_API_KEY=
BALLOTPEDIA_BASE_URL=https://api4.ballotpedia.org/data
DEMOCRACY_WORKS_API_KEY=
DEMOCRACY_WORKS_BASE_URL=
AP_ELECTIONS_API_KEY=
AP_ELECTIONS_BASE_URL=
VOTESMART_API_KEY=
VOTESMART_BASE_URL=https://api.paas.votesmart.io/api
CICERO_API_KEY=
CICERO_BASE_URL=
GOOGLE_CIVIC_API_KEY=
GOOGLE_CIVIC_BASE_URL=https://www.googleapis.com/civicinfo/v2
GOOGLE_CIVIC_USAGE=fallback_only
ALLOW_CURATED_LOCAL_ELECTION_SEEDS=true

# HeroUI Pro developer tooling
# Use locally for the HeroUI Pro MCP only. Never commit a real token.
HEROUI_PERSONAL_TOKEN=
HEROUI_PRO_MCP_URL=https://mcp.heroui.pro/mcp
HEROUI_THEME=brutalism
DISTRICTLENS_THEME_VARIANT=civic-brutal

# Optional local race extraction bridge
# Use only for schema-constrained extraction from official election-office URLs.
TABSTACK_API_KEY=
TABSTACK_LOCAL_EXTRACTION_ENABLED=false
TABSTACK_EXTRACTION_EFFORT=standard
TABSTACK_USE_NOCACHE=true
TABSTACK_SCHEMA_VERSION=local-race-v1

# Post-MVP state/local ballot layer; keep disabled for hackathon MVP.
STATE_LOCAL_BALLOT_LAYER_ENABLED=false
LOCAL_RACES_MVP_ENABLED=false


# unitedstates/congress-legislators enrichment import
CONGRESS_LEGISLATORS_BASE_URL=https://unitedstates.github.io/congress-legislators
CONGRESS_LEGISLATORS_GITHUB_REPO=https://github.com/unitedstates/congress-legislators
CONGRESS_LEGISLATORS_IMPORT_ENABLED=true
CONGRESS_LEGISLATORS_PHOTO_RESOLVER_ENABLED=false
