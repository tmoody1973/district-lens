          "govtrack_id": 1
        },
        {
          "social.twitter": 1
        },
        {
          "social.facebook": 1
        },
        {
          "social.youtube_id": 1
        }
      ]
    },
    "legislator_district_offices": {
      "description": "District office addresses, phones, and geocodes for current members imported from unitedstates/congress-legislators legislators-district-offices.",
      "key_fields": [
        "bioguide_id",
        "offices",
        "source_system",
        "source_url",
        "import_batch_id",
        "ingested_at",
        "last_checked_at",
        "checksum"
