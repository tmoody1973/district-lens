    },
    "congress_committees": {
      "description": "Current committee and subcommittee metadata imported from unitedstates/congress-legislators committees-current.",
      "key_fields": [
        "committee_id",
        "name",
        "type",
        "url",
        "jurisdiction",
        "subcommittees",
        "source_system",
        "source_url",
        "import_batch_id",
        "ingested_at",
        "checksum"
      ],
      "indexes": [
        {
          "committee_id": 1
        },
        {
          "name": "text"
        },
        {
          "type": 1
        }
      ]
    },
    "legislator_committee_memberships": {
      "description": "Current committee and subcommittee assignments imported from unitedstates/congress-legislators committee-membership-current.",
      "key_fields": [
        "bioguide_id",
        "committee_id",
        "subcommittee_id",
        "rank",
        "title",
        "party",
        "source_system",
        "source_url",
        "import_batch_id",
        "ingested_at",
