# DistrictLens monorepo .gitignore
# See agent/.gitignore and web/.gitignore for layer-specific patterns.

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key
.mcp.json

# Cloud / auth
.gcp-credentials.json
service-account-*.json
gha-creds-*.json

# Python (mirrors agent/.gitignore essentials)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# uv
.venv/
venv/
env/

# Node / Next.js (for future web/)
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Logs and local caches
*.log
.cache/
tmp/
.tmp/
.remember/

# Demo prep / load test artifacts
tests/load_test/.results/*.csv
tests/load_test/.results/*.html
agent/tests/load_test/.results/*.csv
agent/tests/load_test/.results/*.html

# Terraform — never commit state, plans, lock dirs, or local var overrides.
# Keep vars/env.tfvars (the committed template); ignore everything else under vars/.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.binary
crash.log
crash.*.log
override.tf
override.tf.json
**/terraform/**/vars/local.tfvars
**/terraform/**/vars/*.local.tfvars

# Playwright browser test artifacts (generated by Claude Code MCP)
.playwright-mcp/

# Generated agent & tooling artifacts (never commit)
# ADK / agents-cli eval run history
agent/app/.adk/eval_history/
# Local test-run scratch output
agent/scripts/position_search_test_results.json
# Ephemeral Claude Code agent worktrees (keep .claude/rules tracked)
.claude/worktrees/
# Superpowers local brainstorm/session scratch
.superpowers/
# PAI session working memory, not repo docs
MEMORY/

!**/.placeholder
!**/.gitkeep
