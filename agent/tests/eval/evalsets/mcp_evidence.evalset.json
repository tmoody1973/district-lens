{
  "eval_set_id": "mcp_evidence",
  "name": "MCP Evidence — MongoDB Partner Integration",
  "description": "Proves the MongoDB MCP toolset (mongodbfind, mongodbaggregate, mongodbcount) is invoked during retrieval and that tool-retrieved data is cited in the response rather than recalled from model memory. Partner integration requirement for hackathon judging.",
  "eval_cases": [
    {
      "eval_id": "mcp_01_mcp_find_in_candidates",
      "conversation": [
        {
          "user_content": {
            "parts": [{"text": "Query the candidates collection directly for all 2026 House candidates in Wisconsin."}]
          },
          "intermediate_data": {
            "tool_uses": [
              {"name": "mongodbfind", "args": {"collection": "candidates", "filter": {"state": "WI"}}}
            ]
          }
        }
      ],
      "session_input": {
        "app_name": "app",
        "user_id": "eval_user",
        "state": {}
      }
    },
    {
      "eval_id": "mcp_02_mcp_aggregate_finance",
      "conversation": [
        {
          "user_content": {
            "parts": [{"text": "Use the database to aggregate total PAC contributions across all candidates in the 2026-H-WI-04 race."}]
          },
          "intermediate_data": {
            "tool_uses": [
              {"name": "mongodbaggregate", "args": {"collection": "finance_summaries"}}
            ]
          }
        }
